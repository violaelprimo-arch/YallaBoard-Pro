        <Color x:Key="BgLighter">#2A3256</Color>
        <Color x:Key="AccentBlue">#005FB8</Color>
        <Color x:Key="AccentGreen">#25D366</Color>
        <Color x:Key="TextWhite">#FFFFFF</Color>
        <Color x:Key="TextGray">#A0AABF</Color>

        <!-- أيقونات هندسية عالية الدقة -->
        <!-- أيقونة الواتساب -->
