<Window x:Class="YallaBoard.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YallaBoard Pro" Height="1080" Width="1920"
        WindowStyle="None" WindowState="Maximized" FlowDirection="RightToLeft"
        Background="#14192D">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/> <!-- الشريط العلوي الأساسي -->
            <RowDefinition Height="40"/> <!-- شريط الأدوات الثانوي -->
            <RowDefinition Height="*"/>  <!-- مساحة العمل والصفحات -->
            <RowDefinition Height="Auto"/> <!-- اللوحات السفلية -->
        </Grid.RowDefinitions>

        <!-- ================= 1. الشريط العلوي ================= -->
        <Border Grid.Row="0" Background="#0C101D" MouseLeftButtonDown="DragWindow">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- لوجو واسم الدرس -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="YALLABOARD" Foreground="White" FontSize="22" FontWeight="Bold" Margin="10,0"/>
                    <TextBlock Text=" | درس الهندسة والتحليل ✎" Foreground="#A0AABF" FontSize="16" VerticalAlignment="Center" Margin="20,0"/>
                </StackPanel>

                <!-- التبويبات في المنتصف -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="السبورة" Background="#005FB8" Foreground="White" Padding="20,5" Margin="5" BorderThickness="0" CornerRadius="5"/>
                    <Button Content="ملف PDF" Background="Transparent" Foreground="White" Padding="20,5" Margin="5" BorderThickness="1" BorderBrush="#3B4261" CornerRadius="5"/>
                    <Button Content="الملفات" Background="Transparent" Foreground="White" Padding="20,5" Margin="5" BorderThickness="1" BorderBrush="#3B4261" CornerRadius="5"/>
                </StackPanel>

                <!-- تسجيل الشاشة والإغلاق -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔴 تسجيل الشاشة" Background="#2A3256" Foreground="White" Padding="15,5" Margin="10,0" BorderThickness="0" CornerRadius="5"/>
                    <Button Content="⚙️" Style="{StaticResource FlatBtn}" FontSize="18" Margin="5"/>
                    <Button Content="➖" Style="{StaticResource FlatBtn}" FontSize="18" Margin="5"/>
                    <Button Content="❌" Style="{StaticResource FlatBtn}" FontSize="18" Margin="5" Foreground="#FF4C4C" Click="CloseApp_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 2. الشريط الثانوي ================= -->
        <Border Grid.Row="1" Background="#1E2541" BorderBrush="#2A3256" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="≡" Style="{StaticResource FlatBtn}" FontSize="20" Width="40"/>
                    <Button Content="⮌" Style="{StaticResource FlatBtn}" FontSize="18" Width="40"/>
                    <Button Content="⮎" Style="{StaticResource FlatBtn}" FontSize="18" Width="40"/>
                    <TextBlock Text="100%" Foreground="White" VerticalAlignment="Center" Margin="10,0"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="استيراد 📥" Style="{StaticResource FlatBtn}" Margin="10,0"/>
                    <Button Content="تصدير 📤" Style="{StaticResource FlatBtn}" Margin="10,0"/>
                    
                    <Border Background="#25D366" CornerRadius="15" Padding="10,2" Margin="10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconWhatsApp}" Fill="White" Stretch="Uniform" Width="16" Height="16" Margin="0,0,5,0"/>
                            <TextBlock Text="مشاركة واتساب" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 3. منطقة العمل المركزية ================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- الصفحات -->
                <ColumnDefinition Width="*"/>    <!-- السبورة 1 -->
                <ColumnDefinition Width="*"/>    <!-- السبورة 2 -->
                <ColumnDefinition Width="Auto"/> <!-- الأدوات -->
            </Grid.ColumnDefinitions>

            <!-- اللوحة اليسرى (الصفحات) -->
            <Border x:Name="PagesPanel" Grid.Column="0" Width="120" Background="#1E2541" BorderBrush="#2A3256" BorderThickness="1,0,0,0">
                <Grid>
                    <TextBlock Text="الصفحات" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <Button Content="❌" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource FlatBtn}" Click="TogglePages_Click"/>
                    <!-- مربعات وهمية للصفحات -->
                    <StackPanel Margin="0,40,0,0">
                        <Border Height="80" Margin="10" Background="White" CornerRadius="5"/>
                        <Border Height="80" Margin="10" Background="White" CornerRadius="5"/>
                        <Button Content="+ إضافة صفحة" Background="#2A3256" Foreground="White" Margin="10" BorderThickness="0" Padding="5"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- منطقة الشرح (انقسام الشاشة) -->
            <Border Grid.Column="1" Background="#F4F4F4" Margin="5" CornerRadius="10">
                <InkCanvas Background="Transparent"/>
            </Border>
            <Border Grid.Column="2" Background="#FFFFFF" Margin="5" CornerRadius="10">
                <InkCanvas Background="Transparent"/>
            </Border>

            <!-- اللوحة اليمنى (أدوات الرسم) -->
            <Border x:Name="ToolsPanel" Grid.Column="3" Width="80" Background="#1E2541" BorderBrush="#2A3256" BorderThickness="0,0,1,0">
                <StackPanel HorizontalAlignment="Center" Margin="0,10">
                    <Button Content="❌" Style="{StaticResource FlatBtn}" Click="ToggleTools_Click" Margin="0,0,0,10"/>
                    
                    <Button Style="{StaticResource FlatBtn}" Width="60" Height="60" Margin="0,5" Background="#005FB8">
                        <StackPanel>
                            <Path Data="{StaticResource IconPen}" Fill="White" Stretch="Uniform" Width="20" Height="20"/>
                            <TextBlock Text="القلم" Foreground="White" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Style="{StaticResource FlatBtn}" Width="60" Height="60" Margin="0,5">
                        <StackPanel>
                            <Path Data="{StaticResource IconHighlighter}" Fill="#FFEB3B" Stretch="Uniform" Width="20" Height="20"/>
                            <TextBlock Text="التظليل" Foreground="White" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource FlatBtn}" Width="60" Height="60" Margin="0,5">
                        <StackPanel>
                            <Path Data="{StaticResource IconEraser}" Fill="White" Stretch="Uniform" Width="20" Height="20"/>
                            <TextBlock Text="الممحاة" Foreground="White" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- باقي الأدوات (الهندسة، المسطرة، الخ) -->
                    <TextBlock Text="📐 هندسة" Foreground="White" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                    <TextBlock Text="📏 مسطرة" Foreground="White" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                    <TextBlock Text="T نص" Foreground="White" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= 4. اللوحات السفلية (المكتبة، القلم، المؤقت) ================= -->
        <Grid Grid.Row="3" Margin="10" Height="220">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. المكتبة -->
            <Border x:Name="LibraryPanel" Grid.Column="0" Background="#1E2541" CornerRadius="10" Margin="5">
                <Grid>
                    <TextBlock Text="📚 المكتبة" Foreground="White" Margin="15,10" FontWeight="Bold"/>
                    <Button Content="❌" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource FlatBtn}" Click="ToggleLibrary_Click" Margin="5"/>
                </Grid>
            </Border>

            <!-- 2. إعدادات القلم -->
            <Border x:Name="PenSettingsPanel" Grid.Column="1" Background="#1E2541" CornerRadius="10" Margin="5">
                <Grid>
                    <TextBlock Text="🖊️ إعدادات القلم" Foreground="White" Margin="15,10" FontWeight="Bold"/>
                    <Button Content="❌" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource FlatBtn}" Click="TogglePenSettings_Click" Margin="5"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="الألوان:" Foreground="White" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10">
                            <Ellipse Fill="#FF0000" Width="30" Height="30" Margin="5"/>
                            <Ellipse Fill="#005FB8" Width="30" Height="30" Margin="5"/>
                            <Ellipse Fill="#000000" Width="30" Height="30" Margin="5"/>
                            <Ellipse Fill="#25D366" Width="30" Height="30" Margin="5"/>
                        </StackPanel>
                        <TextBlock Text="السُمك:" Foreground="White" HorizontalAlignment="Center"/>
                        <Slider Width="200" Minimum="1" Maximum="30" Value="5" Margin="0,10"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. المؤقت -->
            <Border x:Name="TimerPanel" Grid.Column="2" Background="#1E2541" CornerRadius="10" Margin="5">
                <Grid>
                    <TextBlock Text="⏱️ المؤقت" Foreground="White" Margin="15,10" FontWeight="Bold"/>
                    <Button Content="❌" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource FlatBtn}" Click="ToggleTimer_Click" Margin="5"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="10:00" Foreground="White" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                            <Button Content="▶ بدء" Background="#25D366" Foreground="White" Padding="15,5" CornerRadius="5" BorderThickness="0" Margin="5"/>
                            <Button Content="⏸ إيقاف" Background="#3B4261" Foreground="White" Padding="15,5" CornerRadius="5" BorderThickness="0" Margin="5"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
