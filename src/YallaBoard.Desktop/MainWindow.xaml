<Window x:Class="YallaBoard.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YallaBoard Pro" Height="1080" Width="1920"
        WindowStyle="None" WindowState="Maximized" FlowDirection="RightToLeft">
    
    <Grid Background="#F4F6F9">
        <!-- مساحة الرسم الأساسية -->
        <InkCanvas x:Name="MainBoard" Background="White" Margin="0,50,0,0"/>

        <!-- الشريط العلوي (Title Bar) مخصص ومدمج -->
        <Border Height="50" Background="{StaticResource BrushMidnight}" VerticalAlignment="Top" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <Grid>
                <!-- اسم البرنامج والشعار -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0" HorizontalAlignment="Left">
                    <TextBlock Text="YallaBoard Pro" Foreground="White" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text=" | مساحة الشرح التفاعلية" Foreground="{StaticResource BrushCyan}" FontSize="16" Margin="10,2,0,0" />
                </StackPanel>
                
                <!-- أزرار التحكم في النافذة -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Style="{StaticResource ToolButtonStyle}" Click="CloseApp_Click" Width="40" Height="40" ToolTip="إغلاق">
                        <Path Data="{StaticResource IconClose}" Fill="#FF4C4C" Stretch="Uniform" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- شريط الأدوات العائم الاحترافي (Glassmorphism) -->
        <Border Background="#EB071952" CornerRadius="20" Margin="0,0,0,30" 
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Padding="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                
                <!-- الألوان كدوائر احترافية -->
                <Button Width="36" Height="36" Margin="4" Click="Color_Click" Tag="#071952" ToolTip="كحلي YallaCodeX">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Ellipse Fill="#071952" Stroke="White" StrokeThickness="2" Cursor="Hand"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Width="36" Height="36" Margin="4" Click="Color_Click" Tag="#088395" ToolTip="بترولي">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Ellipse Fill="#088395" Stroke="White" StrokeThickness="2" Cursor="Hand"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Width="36" Height="36" Margin="4" Click="Color_Click" Tag="#E53935" ToolTip="أحمر">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Ellipse Fill="#E53935" Stroke="White" StrokeThickness="2" Cursor="Hand"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Width="36" Height="36" Margin="4,4,15,4" Click="Color_Click" Tag="#000000" ToolTip="أسود">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Ellipse Fill="#000000" Stroke="White" StrokeThickness="2" Cursor="Hand"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Rectangle Width="1" Fill="#55FFFFFF" Margin="5,0"/>

                <!-- سُمك الخط -->
                <TextBlock Text="السُمك" Foreground="White" VerticalAlignment="Center" Margin="10,0"/>
                <Slider x:Name="ThicknessSlider" Width="100" Minimum="2" Maximum="30" Value="5" ValueChanged="ThicknessSlider_ValueChanged" VerticalAlignment="Center" Margin="5,0"/>
                
                <Rectangle Width="1" Fill="#55FFFFFF" Margin="10,0"/>

                <!-- أدوات الرسم المتجهة -->
                <Button Style="{StaticResource ToolButtonStyle}" Click="PenMode_Click" ToolTip="القلم">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPen}" Fill="White" Stretch="Uniform" Width="20" Height="20"/>
                    </StackPanel>
                </Button>
                
                <Button Style="{StaticResource ToolButtonStyle}" Click="HighlighterMode_Click" ToolTip="قلم التظليل">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconHighlighter}" Fill="#FFEB3B" Stretch="Uniform" Width="20" Height="20"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolButtonStyle}" Click="EraserMode_Click" ToolTip="الممحاة">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconEraser}" Fill="White" Stretch="Uniform" Width="20" Height="20"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolButtonStyle}" Click="ClearBoard_Click" ToolTip="مسح السبورة">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconTrash}" Fill="#FF6B6B" Stretch="Uniform" Width="20" Height="20"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>
