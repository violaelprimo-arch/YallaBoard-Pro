<Window x:Class="YallaBoard.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YallaBoard Pro - YallaCodeX" Height="1080" Width="1920"
        WindowState="Maximized" FlowDirection="RightToLeft">
    
    <Grid Background="#F7F8F0">
        <!-- مساحة الرسم التفاعلية -->
        <InkCanvas x:Name="MainBoard" Margin="0,60,0,0" Background="White" />

        <!-- الشريط العلوي -->
        <Border Height="60" Background="#071952" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="YallaBoard Pro" Foreground="White" FontSize="26" FontWeight="Bold" />
                <TextBlock Text=" | السبورة التفاعلية الذكية" Foreground="#9CD5FF" FontSize="20" Margin="10,4,0,0" />
            </StackPanel>
        </Border>

        <!-- شريط الأدوات العائم الجديد -->
        <Border Background="#EE071952" CornerRadius="15" Margin="0,0,0,30" 
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Padding="15,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.4"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                
                <!-- الألوان (بألوان هوية YallaCodeX) -->
                <Button Background="#071952" Width="40" Height="40" Margin="5" Click="Color_Click" Tag="#071952" ToolTip="كحلي" BorderBrush="White" BorderThickness="2"/>
                <Button Background="#088395" Width="40" Height="40" Margin="5" Click="Color_Click" Tag="#088395" ToolTip="بترولي" BorderBrush="White" BorderThickness="2"/>
                <Button Background="#E53935" Width="40" Height="40" Margin="5" Click="Color_Click" Tag="#E53935" ToolTip="أحمر" BorderBrush="White" BorderThickness="2"/>
                <Button Background="#000000" Width="40" Height="40" Margin="5" Click="Color_Click" Tag="#000000" ToolTip="أسود" BorderBrush="White" BorderThickness="2"/>

                <TextBlock Text="السُمك:" Foreground="White" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <Slider x:Name="ThicknessSlider" Width="100" Minimum="2" Maximum="30" Value="5" ValueChanged="ThicknessSlider_ValueChanged" VerticalAlignment="Center" Margin="5,0"/>

                <!-- أدوات القلم والممحاة -->
                <Button Content="القلم 🖊️" Width="80" Height="40" Margin="15,5,5,5" Click="PenMode_Click" Background="#37B7C3" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="ممحاة 🧽" Width="80" Height="40" Margin="5" Click="EraserMode_Click" Background="#355872" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="مسح الكل 🗑️" Width="90" Height="40" Margin="5" Click="ClearBoard_Click" Background="#E53935" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                
            </StackPanel>
        </Border>
    </Grid>
</Window>
