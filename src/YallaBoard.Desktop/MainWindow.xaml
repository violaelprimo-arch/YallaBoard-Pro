<Window x:Class="YallaBoard.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YallaBoard Pro" Height="1080" Width="1920"
        WindowStyle="None" WindowState="Maximized" FlowDirection="RightToLeft"
        Background="{StaticResource BrushDarkBg}">
    
    <Grid>
        <!-- 1. مساحة السبورة البيضاء -->
        <InkCanvas x:Name="MainBoard" Background="#F8F9FA" Margin="0,50,0,0" 
                   PreviewStylusDown="MainBoard_PreviewTouch" PreviewMouseDown="MainBoard_PreviewTouch"/>

        <!-- 2. الشريط العلوي (Dark Header) -->
        <Border Height="50" Background="{StaticResource BrushPanelBg}" VerticalAlignment="Top" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0" HorizontalAlignment="Left">
                    <!-- لوجو نصي بألوان الهوية -->
                    <TextBlock Text="Yalla" Foreground="{StaticResource BrushOrange}" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Board" Foreground="{StaticResource BrushBlue}" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text=" | مساحة الشرح التفاعلية" Foreground="#888" FontSize="16" Margin="10,6,0,0" />
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Content="⚙️" Style="{StaticResource IconBtnStyle}" ToolTip="الإعدادات"/>
                    <Button Content="❌" Style="{StaticResource IconBtnStyle}" Click="CloseApp_Click" Foreground="#FF4C4C"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. شريط الأدوات العائم (Floating Toolbar) -->
        <Border Background="#D81A1E24" CornerRadius="20" Margin="0,0,0,30" 
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Padding="15,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
            </Border.Effect>
            
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                
                <!-- زر القلم الأساسي -->
                <ToggleButton x:Name="BtnPen" Content="🖋️" Style="{StaticResource {x:Type ToggleButton}}" 
                              Width="50" Height="50" Margin="5" Click="BtnPen_Click" Background="{StaticResource BrushBlue}" Foreground="White" FontSize="20"/>
                
                <!-- نافذة إعدادات القلم المنبثقة -->
                <Popup x:Name="PopupPenSettings" PlacementTarget="{Binding ElementName=BtnPen}" Placement="Top" StaysOpen="False" AllowsTransparency="True" VerticalOffset="-10">
                    <Border Background="{StaticResource BrushPanelBg}" CornerRadius="15" Padding="15">
                        <StackPanel>
                            <TextBlock Text="سُمك القلم:" Foreground="White" Margin="0,0,0,10"/>
                            <Slider x:Name="PenThickness" Minimum="2" Maximum="30" Value="5" Width="150" ValueChanged="PenThickness_ValueChanged"/>
                            
                            <TextBlock Text="نوع السن:" Foreground="White" Margin="0,15,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="عادي ⏺" Click="PenTipRound_Click" Background="#444" Foreground="White" Padding="5" Margin="2"/>
                                <Button Content="مشطوف ▰" Click="PenTipChisel_Click" Background="#444" Foreground="White" Padding="5" Margin="2"/>
                            </StackPanel>

                            <TextBlock Text="اللون:" Foreground="White" Margin="0,15,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Background="{StaticResource BrushOrange}" Width="30" Height="30" Margin="2" Click="Color_Click" Tag="#FF7A00"/>
                                <Button Background="{StaticResource BrushBlue}" Width="30" Height="30" Margin="2" Click="Color_Click" Tag="#00B4D8"/>
                                <Button Background="Black" Width="30" Height="30" Margin="2" Click="Color_Click" Tag="#000000"/>
                                <Button Background="Red" Width="30" Height="30" Margin="2" Click="Color_Click" Tag="#FF0000"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- زر التظليل -->
                <Button Content="🖍️" Style="{StaticResource IconBtnStyle}" FontSize="20" Click="BtnHighlighter_Click"/>
                
                <!-- زر الممحاة -->
                <ToggleButton x:Name="BtnEraser" Content="🧽" Style="{StaticResource {x:Type ToggleButton}}" 
                              Width="50" Height="50" Margin="5" Click="BtnEraser_Click" FontSize="20" Background="Transparent"/>
                
                <Popup x:Name="PopupEraserSettings" PlacementTarget="{Binding ElementName=BtnEraser}" Placement="Top" StaysOpen="False" AllowsTransparency="True" VerticalOffset="-10">
                    <Border Background="{StaticResource BrushPanelBg}" CornerRadius="15" Padding="15">
                        <StackPanel>
                            <TextBlock Text="حجم الممحاة:" Foreground="White" Margin="0,0,0,10"/>
                            <Slider x:Name="EraserSize" Minimum="10" Maximum="100" Value="30" Width="150" ValueChanged="EraserSize_ValueChanged"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <Rectangle Width="2" Fill="#55FFFFFF" Margin="10,5"/>

                <!-- القلم الذكي ومسح الكل -->
                <Button Content="✨" Style="{StaticResource IconBtnStyle}" ToolTip="القلم الذكي (قريباً)" FontSize="20"/>
                <Button Content="🗑️" Style="{StaticResource IconBtnStyle}" Click="ClearBoard_Click" FontSize="20" Foreground="#FF4C4C"/>
                
            </StackPanel>
        </Border>
    </Grid>
</Window>
