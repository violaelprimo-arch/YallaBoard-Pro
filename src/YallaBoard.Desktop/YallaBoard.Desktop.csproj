<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>YallaBoard.Desktop</AssemblyName>
    <Company>YallaCodeX</Company>
    <Product>YallaBoard Pro</Product>
    <Copyright>Copyright © 2026 YallaCodeX. All rights reserved.</Copyright>
    
    <!-- الأوامر التي تحل مشكلة الإغلاق الصامت -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
</Project>
